# Shared between a WSL laptop and a native-Windows desktop: keep text as LF in the repo and working tree.
* text=auto eol=lf

# Windows scripts that need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.vox binary
*.glb binary
*.ttf binary
*.otf binary
*.wav binary
*.flac binary
*.ogg binary
*.mp3 binary
*.mp4 binary
